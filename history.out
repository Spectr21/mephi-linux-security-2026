    1  sudo groupadd students
    2  sudo useradd --create-home --uid 1234 --gid students --shell /bin/bash user1
    3  sudo chage --mindays 0 --maxdays 90 --warndays 7 user1
    4  sudo install --owner=root --group=students --mode=4750 /usr/bin/cat /home/user1/suid-cat
    5  sudo -u user1 /home/user1/suid-cat /etc/shadow
    6  sudo install --owner=root --group=students --mode=0750 /usr/bin/chown /home/user1/cap-chown
    7  sudo setcap cap_chown=ep /home/user1/cap-chown
    8  sudo -u user1 touch /home/user1/capability-test.txt
    9  sudo -u user1 /home/user1/cap-chown root:root /home/user1/capability-test.txt
   10  printf 'user1 ALL=(root) NOPASSWD: /usr/bin/date -s *, /usr/bin/date --set=*\n' | sudo tee /etc/sudoers.d/user1-time
   11  sudo chmod 0440 /etc/sudoers.d/user1-time
   12  sudo visudo -cf /etc/sudoers.d/user1-time
   13  sudo -u user1 sudo -n /usr/bin/date -s "$(date '+%Y-%m-%d %H:%M:%S')"
   14  sudo find / -type f -perm -4000 -printf '%m %u:%g %p\n'
   15  sudo -u user1 passwd
   16  ps -eo pid,ppid,ruid,euid,ruser,euser,comm,args | awk 'NR == 1 || ($3 >= 1000 && $4 == 0)'
   17  stat /home/user1 > ~/stat.out
   18  stat /home/user1/suid-cat >> ~/stat.out
   19  stat /home/user1/cap-chown >> ~/stat.out
   20  getcap /home/user1/cap-chown > ~/getcap.out
   21  history > ~/history.out
   22  history > /home/vagrant/history.out
